# The updater signature is computed over the exact LF bytes of version.xml.
# Never let git rewrite line endings on these, or signature verification fails.
update/version.xml       -text
update/**/version.xml    -text
# The template seeds the next release's manifest, so it has to start out LF too.
update/version.template.xml -text
# Same for the plugin catalog, whose signature covers the exact LF bytes of plugins.json.
plugins.json             -text
*.sign                   binary
*.zip                    binary
