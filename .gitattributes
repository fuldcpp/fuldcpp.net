# The updater signature is computed over the exact LF bytes of version.xml.
# Never let git rewrite line endings on these, or signature verification fails.
update/version.xml       -text
update/**/version.xml    -text
# Same for the plugin catalog, whose signature covers the exact LF bytes of plugins.json.
plugins.json             -text
*.sign                   binary
*.zip                    binary
# Extension catalog: the signature covers the exact LF bytes of catalog.json; the per-package
# documents are generated with the same rule so a checkout never rewrites them.
extensions/catalog.json  -text
extensions/*/latest      -text
extensions/*/index.json  -text
